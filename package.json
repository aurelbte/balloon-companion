{
  "name": "balloon-companion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run validate:load-datasets",
    "build": "next build",
    "test": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test app/lib/*.test.mjs",
    "validate:load-datasets": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-load-datasets.mjs",
    "load-data:download": "node scripts/load-performance/download-official-manuals.mjs",
    "load-data:extract": "node scripts/load-performance/extract-load-tables.mjs",
    "load-data:validate": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/load-performance/validate-extracted-load-data.mjs",
    "load-data:generate": "node scripts/load-performance/generate-load-datasets.mjs",
    "load-data:compare": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/load-performance/compare-reference-cases.mjs",
    "audit:weather-models": "node scripts/audit-weather-models.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "lucide-react": "^1.25.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
